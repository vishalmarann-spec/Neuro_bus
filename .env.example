APP_ENV=development
APP_NAME=Neuro_Bus API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://neurobus:neurobus@localhost:5432/neurobus
REDIS_URL=redis://localhost:6379/0
SOURCE_FETCH_TIMEOUT_SECONDS=15
SOURCE_FETCH_MAX_REDIRECTS=3
SOURCE_FETCH_MAX_RESPONSE_BYTES=5242880
SOURCE_FETCH_MAX_ATTEMPTS=3
SOURCE_FETCH_RETRY_BASE_SECONDS=0.5
SOURCE_FETCH_HOST_INTERVAL_SECONDS=1
SOURCE_FETCH_MAX_CRAWL_DELAY_SECONDS=10
CONNECTOR_WORKER_POLL_SECONDS=1
CONNECTOR_WORKER_LEASE_SECONDS=300
MODEL_PROVIDER=disabled
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_OUTPUT_TOKENS=4096
# Configure both rates only when you want estimated per-run cost recorded.
MODEL_INPUT_COST_PER_MILLION_USD=
MODEL_OUTPUT_COST_PER_MILLION_USD=
LOG_LEVEL=INFO
