APP_ENV=development
APP_NAME=Neuro_Bus API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://neurobus:neurobus@localhost:5432/neurobus
REDIS_URL=redis://localhost:6379/0
MODEL_PROVIDER=disabled
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_OUTPUT_TOKENS=4096
# Configure both rates only when you want estimated per-run cost recorded.
MODEL_INPUT_COST_PER_MILLION_USD=
MODEL_OUTPUT_COST_PER_MILLION_USD=
LOG_LEVEL=INFO
